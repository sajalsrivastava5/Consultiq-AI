# Copy this file to .env and fill in the values you need.
# Every setting has a safe default in config.py, so ConsultIQ AI runs out of
# the box in offline "demo" mode with no keys at all.

# --- App ---
APP_ENV=development
APP_DEBUG=true

# --- LLM Provider: demo | openai | azure_openai | ollama ---
# "demo" (default) needs zero API keys — it answers with an extractive,
# citation-backed summary of retrieved passages instead of calling an LLM.
LLM_PROVIDER=demo

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01

# Ollama (local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Embeddings ---
# Requires internet access on first run to download the model from
# HuggingFace. Falls back automatically to an offline hashing embedder if
# unavailable (see embeddings/embedding_engine.py).
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM_FALLBACK=2048

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
TOP_K=5
SIMILARITY_THRESHOLD=0.25

# --- Security ---
MAX_UPLOAD_MB=25
SESSION_TIMEOUT_MINUTES=60
